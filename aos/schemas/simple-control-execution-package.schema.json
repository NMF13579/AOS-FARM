{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AOS Simple Control Execution Package",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "package_version",
    "package_id",
    "task_id",
    "operation_class",
    "request_binding",
    "preview_binding",
    "authorization_binding",
    "repository_observation_binding",
    "repository_baseline_binding",
    "candidate_actions",
    "required_validation",
    "mandatory_controls",
    "execution_backend",
    "production_execution",
    "grants",
    "non_grants"
  ],
  "properties": {
    "package_version": {"const": 1},
    "operation_class": {"const": "SCOPED_EXECUTION_PREPARATION"},
    "repository_baseline_binding": {
      "type": "object",
      "required": [
        "repository",
        "branch",
        "head"
      ],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "branch": {"type": "string", "minLength": 1},
        "head": {"type": "string", "minLength": 1}
      }
    },
    "execution_backend": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "NOT_BOUND",
            "CONTROLLED_LOCAL_WRITE_BOUND"
          ]
        }
      }
    },
    "production_execution": {
      "type": "object",
      "properties": {
        "available": {"type": "boolean"},
        "reason_code": {
          "enum": [
            "OPERATION_CONTROL_FOUNDATION_NOT_IMPLEMENTED",
            "PRODUCTION_EXECUTION_AUTHORIZATION_REQUIRED",
            null
          ]
        }
      }
    }
  }
}
