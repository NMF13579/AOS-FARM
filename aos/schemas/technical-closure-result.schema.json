{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aos-farm.local/schemas/technical-closure-result.schema.json",
  "title": "AOS Technical Closure Result",
  "oneOf": [
    {"$ref": "#/$defs/technical_closure_result"},
    {"$ref": "#/$defs/contract_error"},
    {"$ref": "#/$defs/terminal_command_result"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "technical_status": {"enum": ["PASS", "FAIL", "UNKNOWN", "NOT_RUN"]},
    "control_status": {"enum": ["HUMAN_REVIEW_REQUIRED", "BLOCKED", "UNKNOWN_BLOCKED"]},
    "closure_status": {
      "enum": [
        "CLOSURE_OPEN",
        "CLOSURE_CORRECTION_REQUIRED",
        "CLOSURE_HUMAN_DECISION_REQUIRED",
        "CLOSURE_TECHNICALLY_CLOSED"
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "next_required_action": {
      "enum": [
        "HUMAN_CORRECTION_DECISION",
        "HUMAN_RESOLVE_UNKNOWN",
        "HUMAN_VALIDATION_DECISION",
        "HUMAN_EXECUTION_DECISION",
        "HUMAN_COMMIT_DECISION",
        "HUMAN_PUSH_DECISION",
        "HUMAN_INTEGRATION_DECISION",
        "HUMAN_RESULT_REVIEW",
        "NO_FURTHER_AUTOMATIC_ACTION"
      ]
    },
    "required_human_decision": {
      "enum": [
        "NONE",
        "HUMAN_EXECUTION_DECISION",
        "HUMAN_COMMIT_DECISION",
        "HUMAN_PUSH_DECISION",
        "HUMAN_INTEGRATION_DECISION",
        "HUMAN_RESULT_REVIEW"
      ]
    },
    "non_grant_flags": {
      "type": "object",
      "required": [
        "continue_allowed",
        "broad_reaudit_started",
        "approval_granted",
        "execution_authorized",
        "commit_authorized",
        "push_authorized",
        "integration_authorized",
        "release_authorized",
        "operation_started",
        "background_action_started",
        "schedule_created",
        "lifecycle_mutated",
        "next_stage_started"
      ],
      "properties": {
        "continue_allowed": {"const": false},
        "broad_reaudit_started": {"const": false},
        "approval_granted": {"const": false},
        "execution_authorized": {"const": false},
        "commit_authorized": {"const": false},
        "push_authorized": {"const": false},
        "integration_authorized": {"const": false},
        "release_authorized": {"const": false},
        "operation_started": {"const": false},
        "background_action_started": {"const": false},
        "schedule_created": {"const": false},
        "lifecycle_mutated": {"const": false},
        "next_stage_started": {"const": false}
      }
    },
    "technical_closure_result": {
      "allOf": [
        {"$ref": "#/$defs/non_grant_flags"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "response_kind",
            "schema_version",
            "task_id",
            "subject_digest",
            "evaluation_input_digest",
            "result_digest",
            "technical_status",
            "control_status",
            "closure_status",
            "binding_changed",
            "evaluation_input_changed",
            "reopened",
            "stale_inputs",
            "reason_codes",
            "required_human_decision",
            "next_required_action",
            "continue_allowed",
            "broad_reaudit_may_be_proposed",
            "broad_reaudit_started",
            "approval_granted",
            "execution_authorized",
            "commit_authorized",
            "push_authorized",
            "integration_authorized",
            "release_authorized",
            "operation_started",
            "background_action_started",
            "schedule_created",
            "lifecycle_mutated",
            "next_stage_started"
          ],
          "properties": {
            "response_kind": {"const": "TECHNICAL_CLOSURE_RESULT"},
            "schema_version": {"const": 1},
            "task_id": {"type": "string", "minLength": 1},
            "subject_digest": {"$ref": "#/$defs/sha256"},
            "evaluation_input_digest": {"$ref": "#/$defs/sha256"},
            "result_digest": {"$ref": "#/$defs/sha256"},
            "technical_status": {"$ref": "#/$defs/technical_status"},
            "control_status": {"$ref": "#/$defs/control_status"},
            "closure_status": {"$ref": "#/$defs/closure_status"},
            "binding_changed": {"type": "boolean"},
            "evaluation_input_changed": {"type": "boolean"},
            "reopened": {"type": "boolean"},
            "stale_inputs": {"type": "array", "items": {"type": "string"}},
            "reason_codes": {"$ref": "#/$defs/reason_codes"},
            "required_human_decision": {"$ref": "#/$defs/required_human_decision"},
            "next_required_action": {"$ref": "#/$defs/next_required_action"},
            "continue_allowed": {"const": false},
            "broad_reaudit_may_be_proposed": {"type": "boolean"},
            "broad_reaudit_started": {"const": false},
            "approval_granted": {"const": false},
            "execution_authorized": {"const": false},
            "commit_authorized": {"const": false},
            "push_authorized": {"const": false},
            "integration_authorized": {"const": false},
            "release_authorized": {"const": false},
            "operation_started": {"const": false},
            "background_action_started": {"const": false},
            "schedule_created": {"const": false},
            "lifecycle_mutated": {"const": false},
            "next_stage_started": {"const": false}
          }
        }
      ]
    },
    "contract_error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "response_kind",
        "schema_version",
        "task_id",
        "subject_digest",
        "evaluation_input_digest",
        "input_payload_digest",
        "result_digest",
        "technical_status",
        "control_status",
        "closure_status",
        "reason_codes",
        "next_required_action",
        "continue_allowed",
        "broad_reaudit_may_be_proposed",
        "broad_reaudit_started",
        "approval_granted",
        "execution_authorized",
        "commit_authorized",
        "push_authorized",
        "integration_authorized",
        "release_authorized",
        "operation_started",
        "background_action_started",
        "schedule_created",
        "lifecycle_mutated",
        "next_stage_started"
      ],
      "properties": {
        "response_kind": {"const": "CONTRACT_ERROR"},
        "schema_version": {"const": 1},
        "task_id": {"type": ["string", "null"], "minLength": 1},
        "subject_digest": {"const": null},
        "evaluation_input_digest": {"const": null},
        "input_payload_digest": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "result_digest": {"$ref": "#/$defs/sha256"},
        "technical_status": {"const": "FAIL"},
        "control_status": {"const": "BLOCKED"},
        "closure_status": {"const": "CLOSURE_CORRECTION_REQUIRED"},
        "reason_codes": {"$ref": "#/$defs/reason_codes"},
        "next_required_action": {"const": "HUMAN_CORRECTION_DECISION"},
        "continue_allowed": {"const": false},
        "broad_reaudit_may_be_proposed": {"const": false},
        "broad_reaudit_started": {"const": false},
        "approval_granted": {"const": false},
        "execution_authorized": {"const": false},
        "commit_authorized": {"const": false},
        "push_authorized": {"const": false},
        "integration_authorized": {"const": false},
        "release_authorized": {"const": false},
        "operation_started": {"const": false},
        "background_action_started": {"const": false},
        "schedule_created": {"const": false},
        "lifecycle_mutated": {"const": false},
        "next_stage_started": {"const": false}
      }
    },
    "terminal_command_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "response_kind",
        "schema_version",
        "command",
        "result_digest",
        "terminal",
        "next_required_action",
        "continue_allowed",
        "closure_result_mutated",
        "approval_granted",
        "execution_authorized",
        "commit_authorized",
        "push_authorized",
        "integration_authorized",
        "release_authorized",
        "operation_started",
        "background_action_started",
        "broad_reaudit_started",
        "schedule_created",
        "lifecycle_mutated",
        "next_stage_started"
      ],
      "properties": {
        "response_kind": {"const": "TERMINAL_COMMAND_RESULT"},
        "schema_version": {"const": 1},
        "command": {"const": "STOP"},
        "result_digest": {"$ref": "#/$defs/sha256"},
        "terminal": {"const": true},
        "next_required_action": {"const": "NO_FURTHER_AUTOMATIC_ACTION"},
        "continue_allowed": {"const": false},
        "closure_result_mutated": {"const": false},
        "approval_granted": {"const": false},
        "execution_authorized": {"const": false},
        "commit_authorized": {"const": false},
        "push_authorized": {"const": false},
        "integration_authorized": {"const": false},
        "release_authorized": {"const": false},
        "operation_started": {"const": false},
        "background_action_started": {"const": false},
        "broad_reaudit_started": {"const": false},
        "schedule_created": {"const": false},
        "lifecycle_mutated": {"const": false},
        "next_stage_started": {"const": false}
      }
    }
  }
}
