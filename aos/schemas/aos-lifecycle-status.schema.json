{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AOS Lifecycle Status",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "project",
    "branch",
    "head",
    "origin_dev",
    "origin_main",
    "working_tree",
    "detected_task",
    "detected_lifecycle_phase",
    "last_completed_task",
    "last_remote_closure",
    "analysis_status",
    "evidence",
    "missing_evidence",
    "open_unknowns",
    "warnings",
    "next_required_human_checkpoint",
    "allowed_next_actions",
    "forbidden_actions",
    "source_of_truth_note",
    "approval_note",
    "notes"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "generated_at": { "type": "string" },
    "project": { "type": "string" },
    "branch": { "type": "string" },
    "head": { "type": "string" },
    "origin_dev": { "type": "string" },
    "origin_main": { "type": "string" },
    "working_tree": { "type": "string" },
    "detected_task": { "type": "string" },
    "detected_lifecycle_phase": { "type": "string" },
    "last_completed_task": { "type": "string" },
    "last_remote_closure": { "type": "string" },
    "analysis_status": { 
      "type": "string",
      "enum": ["STATUS_COLLECTED", "HANDOFF_COLLECTED", "UNKNOWN_BLOCKED", "BLOCKED"]
    },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "missing_evidence": { "type": "array", "items": { "type": "string" } },
    "open_unknowns": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "next_required_human_checkpoint": { "type": "string" },
    "allowed_next_actions": { "type": "array", "items": { "type": "string" } },
    "forbidden_actions": { "type": "array", "items": { "type": "string" } },
    "source_of_truth_note": { "type": "string" },
    "approval_note": { "type": "string" },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
