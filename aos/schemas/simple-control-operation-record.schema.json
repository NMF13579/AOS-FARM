{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AOS Simple Control Operation Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation_record_version",
    "operation_id",
    "task_id",
    "execution_package_binding",
    "authorization_binding",
    "repository_baseline_binding",
    "operation_state",
    "requested_actions",
    "completed_actions",
    "created_at",
    "updated_at",
    "started_at",
    "completed_at",
    "side_effect_started",
    "side_effect_verified",
    "preimage_results",
    "postimage_results",
    "last_error",
    "reconciliation_required",
    "approval_status",
    "Evidence_status"
  ],
  "properties": {
    "operation_record_version": {"const": 1},
    "operation_id": {"type": "string", "pattern": "^op-[a-f0-9]{24,64}$"},
    "task_id": {"type": "string"},
    "execution_package_binding": {"type": "string", "minLength": 64, "maxLength": 64},
    "authorization_binding": {"type": "string", "minLength": 64, "maxLength": 64},
    "repository_baseline_binding": {"type": ["object", "string"]},
    "operation_state": {
      "enum": [
        "OPERATION_REQUESTED",
        "OPERATION_CONFIRMED",
        "OPERATION_PRECONDITIONS_VERIFIED",
        "OPERATION_STARTED",
        "OPERATION_VERIFYING",
        "OPERATION_COMPLETED",
        "OPERATION_FAILED",
        "OPERATION_CANCELLED_BEFORE_START",
        "OPERATION_RECONCILIATION_REQUIRED"
      ]
    },
    "requested_actions": {"type": "array"},
    "completed_actions": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "started_at": {"type": ["string", "null"]},
    "completed_at": {"type": ["string", "null"]},
    "side_effect_started": {"type": "boolean"},
    "side_effect_verified": {"type": "boolean"},
    "preimage_results": {"type": "array"},
    "postimage_results": {"type": "array"},
    "last_error": {"type": ["string", "null"]},
    "reconciliation_required": {"type": "boolean"},
    "approval_status": {"const": "NOT_PROVIDED"},
    "Evidence_status": {"const": "NOT_RUN"}
  }
}
